{
  "name": "@codeday/topo-gallery",
  "version": "0.0.0",
  "private": true,
  "description": "Component gallery for @codeday/topo — a Storybook story per component, verified by Playwright against the built static Storybook.",
  "scripts": {
    "dev": "storybook dev -p 3100 --no-open",
    "build": "storybook build -o dist",
    "start": "storybook build -o dist && npx http-server dist -p 3100 -s",
    "clean": "rm -rf dist storybook-static",
    "check-types": "tsc --noEmit",
    "test": "storybook build -o dist && playwright test"
  },
  "dependencies": {
    "@chakra-ui/react": "catalog:",
    "@codeday/topo": "workspace:*",
    "@codeday/topocons": "workspace:*",
    "@wrksz/themes": "^0.7.9",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@codeday/tsconfig": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "http-server": "^14.1.1",
    "storybook": "^10.6.0",
    "typescript": "catalog:",
    "vite": "^8.3.0"
  }
}
